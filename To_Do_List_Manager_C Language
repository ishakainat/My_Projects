int main() {
    printf("\n╔════════════════════════════════════════╗\n");
    printf("║       TO-DO LIST APPLICATION         ║\n");
    printf("╚════════════════════════════════════════╝\n");
    
    loadTasks(); // Load tasks on startup
    
    while (1) {
        displayMenu();
        int choice;
        scanf("%d", &choice);
        getchar(); // Clear newline
        
        switch (choice) {
            case 1:
                addTask();
                break;
            case 2:
                viewAllTasks();
                break;
            case 3:
                viewTasksByStatus();
                break;
            case 4:
                markComplete();
                break;
            case 5:
                deleteTask();
                break;
            case 6:
                searchTasks();
                break;
            case 7:
                sortMenu();
                int sortChoice;
                scanf("%d", &sortChoice);
                getchar();
                if (sortChoice == 1) sortByPriority();
                else if (sortChoice == 2) sortByDueDate();
                else printf("❌ Invalid choice.\n");
                break;
            case 8:
                showStatistics();
                break;
            case 9:
                saveTasks();
                break;
            case 10:
                loadTasks();
                break;
            case 11:
                printf("\n👋 Thank you for using To-Do List Application!\n");
                saveTasks(); // Auto-save
                return 0;
            default:
                printf("❌ Invalid choice. Please enter 1-11.\n");
        }
        
        waitForEnter();
    }
    
    return 0;
}
