<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>NeonCalc</title>
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body {
            min-height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
            background: #0a0a0a;
            font-family: 'Segoe UI', sans-serif;
            transition: background 0.5s;
        }
        body.light {
            background: linear-gradient(135deg, #f5f7fa, #c3cfe2);
        }
        
        .calc {
            background: rgba(20,20,30,0.95);
            backdrop-filter: blur(10px);
            border-radius: 30px;
            padding: 25px;
            width: 360px;
            box-shadow: 0 20px 60px rgba(0,0,0,0.8), 0 0 40px rgba(0,255,255,0.1);
            border: 1px solid rgba(0,255,255,0.2);
            transition: all 0.5s;
            animation: float 6s ease-in-out infinite;
        }
        body.light .calc {
            background: rgba(255,255,255,0.95);
            box-shadow: 0 20px 60px rgba(0,0,0,0.15);
            border-color: rgba(0,0,0,0.1);
        }
        
        @keyframes float {
            0%,100% { transform: translateY(0); }
            50% { transform: translateY(-8px); }
        }
        
        .header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 20px;
        }
        .brand {
            font-size: 20px;
            font-weight: 700;
            background: linear-gradient(135deg, #00ffff, #ff00ff);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            animation: shimmer 3s ease-in-out infinite;
            background-size: 200% 200%;
        }
        @keyframes shimmer {
            0%,100% { background-position: 0% 50%; }
            50% { background-position: 100% 50%; }
        }
        
        .theme-btn {
            background: rgba(255,255,255,0.1);
            border: 1px solid rgba(255,255,255,0.2);
            color: #fff;
            width: 40px;
            height: 40px;
            border-radius: 50%;
            cursor: pointer;
            font-size: 20px;
            transition: 0.3s;
        }
        body.light .theme-btn {
            background: rgba(0,0,0,0.05);
            border-color: rgba(0,0,0,0.1);
            color: #1a1a2e;
        }
        .theme-btn:hover { transform: rotate(180deg); }
        
        .display {
            background: rgba(0,0,0,0.6);
            border-radius: 20px;
            padding: 20px;
            margin-bottom: 20px;
            min-height: 110px;
            text-align: right;
            border: 1px solid rgba(0,255,255,0.1);
            position: relative;
            overflow: hidden;
        }
        body.light .display {
            background: rgba(0,0,0,0.05);
            border-color: rgba(0,0,0,0.1);
        }
        
        .display::before {
            content: '';
            position: absolute;
            inset: -50%;
            background: conic-gradient(from 0deg, transparent, rgba(0,255,255,0.03), transparent, rgba(255,0,255,0.03), transparent);
            animation: spin 10s linear infinite;
        }
        @keyframes spin { 100% { transform: rotate(360deg); } }
        
        .history {
            font-size: 13px;
            color: rgba(255,255,255,0.3);
            min-height: 20px;
            position: relative;
            z-index: 1;
        }
        body.light .history { color: rgba(0,0,0,0.3); }
        
        .result {
            font-size: 42px;
            font-weight: 700;
            color: #fff;
            position: relative;
            z-index: 1;
            text-shadow: 0 0 20px rgba(0,255,255,0.2);
            transition: 0.3s;
        }
        body.light .result { color: #1a1a2e; }
        .result.pop { animation: pop 0.3s ease; }
        @keyframes pop {
            0% { transform: scale(0.8); opacity: 0.5; }
            50% { transform: scale(1.1); }
            100% { transform: scale(1); opacity: 1; }
        }
        
        .grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 10px;
        }
        
        .btn {
            padding: 18px;
            font-size: 20px;
            font-weight: 600;
            border: none;
            border-radius: 14px;
            cursor: pointer;
            transition: all 0.2s;
            color: #fff;
            background: rgba(255,255,255,0.05);
            user-select: none;
        }
        .btn:hover { transform: translateY(-2px); }
        .btn:active { transform: scale(0.92); }
        body.light .btn { color: #1a1a2e; }
        
        .num { background: rgba(255,255,255,0.08); }
        .num:hover { background: rgba(255,255,255,0.15); }
        body.light .num { background: rgba(0,0,0,0.05); }
        body.light .num:hover { background: rgba(0,0,0,0.1); }
        
        .op { background: rgba(0,255,255,0.15); color: #00ffff; }
        .op:hover { background: rgba(0,255,255,0.25); }
        body.light .op { color: #0066ff; background: rgba(0,255,255,0.1); }
        
        .fn { background: rgba(255,255,0,0.1); color: #ffff00; }
        .fn:hover { background: rgba(255,255,0,0.2); }
        body.light .fn { color: #ccaa00; background: rgba(255,255,0,0.05); }
        
        .eq {
            background: linear-gradient(135deg, #00ffff, #ff00ff);
            color: #fff;
            font-size: 26px;
        }
        .eq:hover { box-shadow: 0 0 30px rgba(0,255,255,0.3); }
        
        .clr { background: rgba(255,0,0,0.15); color: #ff4444; }
        .clr:hover { background: rgba(255,0,0,0.25); }
        body.light .clr { color: #cc0000; background: rgba(255,0,0,0.05); }
        
        .span2 { grid-column: span 2; }
        
        .sci {
            display: grid;
            grid-template-columns: repeat(6, 1fr);
            gap: 6px;
            margin-bottom: 10px;
        }
        .sci-btn {
            padding: 8px;
            font-size: 12px;
            font-weight: 600;
            border: none;
            border-radius: 10px;
            cursor: pointer;
            background: rgba(255,255,255,0.03);
            color: rgba(255,255,255,0.5);
            transition: 0.2s;
        }
        .sci-btn:hover {
            background: rgba(255,255,255,0.08);
            color: #fff;
            transform: translateY(-2px);
        }
        body.light .sci-btn { color: rgba(0,0,0,0.4); }
        body.light .sci-btn:hover { color: #1a1a2e; background: rgba(0,0,0,0.05); }
    </style>
</head>
<body>

<div class="calc">
    <div class="header">
        <div class="brand">⚡ NeonCalc</div>
        <button class="theme-btn" id="themeToggle">🌙</button>
    </div>
    
    <div class="display">
        <div class="history" id="history"></div>
        <div class="result" id="result">0</div>
    </div>
    
    <div class="sci">
        <button class="sci-btn" data-val="sin">sin</button>
        <button class="sci-btn" data-val="cos">cos</button>
        <button class="sci-btn" data-val="tan">tan</button>
        <button class="sci-btn" data-val="sqrt">√</button>
        <button class="sci-btn" data-val="square">x²</button>
        <button class="sci-btn" data-val="factorial">!</button>
        <button class="sci-btn" data-val="log">log</button>
        <button class="sci-btn" data-val="ln">ln</button>
        <button class="sci-btn" data-val="pi">π</button>
        <button class="sci-btn" data-val="e">e</button>
        <button class="sci-btn" data-val="%">%</button>
        <button class="sci-btn" data-val="brackets">( )</button>
    </div>
    
    <div class="grid">
        <button class="btn clr" data-val="clear">⌧</button>
        <button class="btn fn" data-val="backspace">⌫</button>
        <button class="btn op" data-val="/">÷</button>
        <button class="btn op" data-val="*">×</button>
        
        <button class="btn num" data-val="7">7</button>
        <button class="btn num" data-val="8">8</button>
        <button class="btn num" data-val="9">9</button>
        <button class="btn op" data-val="-">−</button>
        
        <button class="btn num" data-val="4">4</button>
        <button class="btn num" data-val="5">5</button>
        <button class="btn num" data-val="6">6</button>
        <button class="btn op" data-val="+">+</button>
        
        <button class="btn num" data-val="1">1</button>
        <button class="btn num" data-val="2">2</button>
        <button class="btn num" data-val="3">3</button>
        <button class="btn eq" data-val="equals">=</button>
        
        <button class="btn num span2" data-val="0">0</button>
        <button class="btn num" data-val=".">.</button>
    </div>
</div>

<script>
// ============================================
// COMPLETE CALCULATOR LOGIC
// ============================================

const resultDisplay = document.getElementById('result');
const historyDisplay = document.getElementById('history');

let current = '';
let expression = '';
let history = '';
let result = '0';
let isResult = false;

// Constants
const constants = { pi: Math.PI, e: Math.E };

// Handle button clicks
document.querySelectorAll('.btn, .sci-btn').forEach(btn => {
    btn.addEventListener('click', () => {
        const val = btn.dataset.val;
        if (val) handleInput(val);
        btn.style.transform = 'scale(0.92)';
        setTimeout(() => btn.style.transform = '', 150);
    });
});

// Keyboard support
document.addEventListener('keydown', e => {
    const key = e.key;
    if (/^[0-9.]$/.test(key)) { e.preventDefault(); handleInput(key); }
    else if (['+', '-', '*', '/'].includes(key)) { e.preventDefault(); handleInput(key); }
    else if (key === 'Enter' || key === '=') { e.preventDefault(); handleInput('equals'); }
    else if (key === 'Escape' || key === 'c') { e.preventDefault(); handleInput('clear'); }
    else if (key === 'Backspace') { e.preventDefault(); handleInput('backspace'); }
});

function handleInput(val) {
    switch(val) {
        case 'clear': clearAll(); break;
        case 'backspace': backspace(); break;
        case 'equals': calculate(); break;
        case 'brackets': handleBrackets(); break;
        case 'pi': case 'e': insertValue(constants[val].toString()); break;
        case 'sin': case 'cos': case 'tan': case 'sqrt': 
        case 'log': case 'ln': case 'square': case 'factorial':
            handleScientific(val); break;
        case '%': handlePercent(); break;
        default: insertValue(val);
    }
    updateDisplay();
}

function insertValue(val) {
    if (isResult) { current = ''; isResult = false; }
    current += val;
}

function backspace() {
    if (isResult) { clearAll(); return; }
    current = current.slice(0, -1);
}

function clearAll() {
    current = '';
    expression = '';
    history = '';
    result = '0';
    isResult = false;
}

function handleBrackets() {
    if (isResult) { current = ''; isResult = false; }
    const open = (current.match(/\(/g) || []).length;
    const close = (current.match(/\)/g) || []).length;
    if (open > close) current += ')';
    else {
        const last = current.slice(-1);
        if (last && /[\d.)]/.test(last)) current += '*(';
        else current += '(';
    }
}

function handleScientific(func) {
    if (isResult) { current = result; isResult = false; }
    current = `${func}(${current || '0'})`;
}

function handlePercent() {
    if (current) {
        const num = parseFloat(current);
        if (!isNaN(num)) current = (num / 100).toString();
    }
}

function calculate() {
    try {
        if (!current && !expression) return;
        let fullExpr = expression + current;
        let calcExpr = fullExpr
            .replace(/×/g, '*').replace(/÷/g, '/').replace(/−/g, '-');
        
        calcExpr = processScientific(calcExpr);
        
        const resultVal = Function('"use strict"; return (' + calcExpr + ')')();
        
        if (typeof resultVal === 'number' && !isNaN(resultVal) && isFinite(resultVal)) {
            history = fullExpr + ' =';
            result = formatNumber(resultVal);
            expression = fullExpr + ' =';
            current = '';
            isResult = true;
            resultDisplay.classList.remove('pop');
            void resultDisplay.offsetWidth;
            resultDisplay.classList.add('pop');
        } else {
            throw new Error('Invalid');
        }
    } catch(e) {
        result = 'Error';
        setTimeout(clearAll, 1500);
    }
}

function processScientific(expr) {
    // Factorial
    expr = expr.replace(/(\d+)!/g, (_, n) => factorial(parseInt(n)).toString());
    // Square
    expr = expr.replace(/square\(([^)]+)\)/g, (_, n) => (parseFloat(n) ** 2).toString());
    // sqrt
    expr = expr.replace(/sqrt\(([^)]+)\)/g, (_, n) => Math.sqrt(parseFloat(n)).toString());
    // sin, cos, tan (in degrees)
    expr = expr.replace(/sin\(([^)]+)\)/g, (_, n) => Math.sin(parseFloat(n) * Math.PI / 180).toString());
    expr = expr.replace(/cos\(([^)]+)\)/g, (_, n) => Math.cos(parseFloat(n) * Math.PI / 180).toString());
    expr = expr.replace(/tan\(([^)]+)\)/g, (_, n) => Math.tan(parseFloat(n) * Math.PI / 180).toString());
    // log, ln
    expr = expr.replace(/log\(([^)]+)\)/g, (_, n) => Math.log10(parseFloat(n)).toString());
    expr = expr.replace(/ln\(([^)]+)\)/g, (_, n) => Math.log(parseFloat(n)).toString());
    return expr;
}

function factorial(n) {
    if (n < 0) return NaN;
    if (n === 0 || n === 1) return 1;
    let r = 1;
    for (let i = 2; i <= n; i++) r *= i;
    return r;
}

function formatNumber(n) {
    return Number.isInteger(n) ? n.toString() : parseFloat(n.toFixed(10)).toString();
}

function updateDisplay() {
    resultDisplay.textContent = result || '0';
    historyDisplay.textContent = history || '\u200B';
}

// Theme toggle
const themeBtn = document.getElementById('themeToggle');
themeBtn.addEventListener('click', () => {
    document.body.classList.toggle('light');
    themeBtn.textContent = document.body.classList.contains('light') ? '☀️' : '🌙';
    localStorage.setItem('theme', document.body.classList.contains('light') ? 'light' : 'dark');
});

// Load saved theme
if (localStorage.getItem('theme') === 'light') {
    document.body.classList.add('light');
    themeBtn.textContent = '☀️';
}
</script>

</body>
</html>
