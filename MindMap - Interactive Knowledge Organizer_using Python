# ============================================
# ENUMS AND CONSTANTS
# ============================================

class Priority(Enum):
    CRITICAL = 5
    HIGH = 4
    MEDIUM = 3
    LOW = 2
    TRIVIAL = 1
    
    def __str__(self):
        return self.name
    
    def get_icon(self):
        icons = {
            Priority.CRITICAL: "🔴",
            Priority.HIGH: "🟠",
            Priority.MEDIUM: "🟡",
            Priority.LOW: "🟢",
            Priority.TRIVIAL: "⚪"
        }
        return icons[self]

class Category(Enum):
    PROGRAMMING = "💻"
    DESIGN = "🎨"
    DATA = "📊"
    BUSINESS = "💼"
    PERSONAL = "🧘"
    LEARNING = "📚"
    HEALTH = "🏋️"
    CREATIVE = "🎭"
    OTHER = "📌"
    
    def __str__(self):
        return self.name
    
    def get_icon(self):
        return self.value

class Status(Enum):
    NOT_STARTED = "⏳"
    IN_PROGRESS = "🔄"
    COMPLETED = "✅"
    BLOCKED = "🚫"
    REVIEW = "👀"
    
    def __str__(self):
        return self.name
    
    def get_icon(self):
        return self.value

# ============================================
# KNOWLEDGE NODE CLASS
# ============================================

@dataclass
class KnowledgeNode:
    id: int
    title: str
    description: str
    category: Category
    priority: Priority = Priority.MEDIUM
    status: Status = Status.NOT_STARTED
    created: datetime = field(default_factory=datetime.now)
    deadline: datetime = field(default_factory=lambda: datetime.now() + timedelta(days=7))
    child_ids: List[int] = field(default_factory=list)
    dependency_ids: List[int] = field(default_factory=list)
    parent_id: int = -1
    energy_required: int = 5
    estimated_hours: int = 1
    actual_hours: int = 0
    tags: List[str] = field(default_factory=list)
    resources: List[str] = field(default_factory=list)
    reflection: str = ""
    
    def get_progress(self) -> float:
        """Calculate progress percentage based on status"""
        progress_map = {
            Status.COMPLETED: 100.0,
            Status.REVIEW: 75.0,
            Status.IN_PROGRESS: 50.0,
            Status.BLOCKED: 25.0,
            Status.NOT_STARTED: 0.0
        }
        return progress_map.get(self.status, 0.0)
    
    def get_urgency_score(self) -> int:
        """Calculate urgency based on deadline"""
        days_until = (self.deadline - datetime.now()).days
        if days_until <= 0:
            return 10
        elif days_until <= 2:
            return 8
        elif days_until <= 5:
            return 6
        elif days_until <= 7:
            return 4
        else:
            return 2
    
    def get_priority_score(self) -> int:
        """Calculate overall priority score (AI-like scoring)"""
        score = 0
        score += self.priority.value * 2  # Priority weight
        score += self.get_urgency_score()
        score += self.energy_required // 2
        score += len(self.child_ids) * 2  # More children = higher impact
        score += len(self.dependency_ids)  # Dependencies increase importance
        return min(100, score)
    
    def get_status_icon(self) -> str:
        return self.status.value
    
    def to_dict(self) -> dict:
        """Convert to dictionary for JSON serialization"""
        return {
            'id': self.id,
            'title': self.title,
            'description': self.description,
            'category': self.category.name,
            'priority': self.priority.name,
            'status': self.status.name,
            'created': self.created.isoformat(),
            'deadline': self.deadline.isoformat(),
            'child_ids': self.child_ids,
            'dependency_ids': self.dependency_ids,
            'parent_id': self.parent_id,
            'energy_required': self.energy_required,
            'estimated_hours': self.estimated_hours,
            'actual_hours': self.actual_hours,
            'tags': self.tags,
            'resources': self.resources,
            'reflection': self.reflection
        }
    
    @classmethod
    def from_dict(cls, data: dict) -> 'KnowledgeNode':
        """Create from dictionary"""
        node = cls(
            id=data['id'],
            title=data['title'],
            description=data['description'],
            category=Category[data['category']],
            priority=Priority[data['priority']],
            status=Status[data['status']],
            deadline=datetime.fromisoformat(data['deadline'])
        )
        node.created = datetime.fromisoformat(data['created'])
        node.child_ids = data['child_ids']
        node.dependency_ids = data['dependency_ids']
        node.parent_id = data['parent_id']
        node.energy_required = data['energy_required']
        node.estimated_hours = data['estimated_hours']
        node.actual_hours = data['actual_hours']
        node.tags = data['tags']
        node.resources = data['resources']
        node.reflection = data['reflection']
        return node
    
    def __str__(self):
        return f"{self.status.value} {self.title} [{self.category.value}] - {self.status.name}"

