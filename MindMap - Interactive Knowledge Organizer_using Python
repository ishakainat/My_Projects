            self.kg.add_reflection(node_id, reflection)
    
    def search_menu(self):
        """Menu for searching nodes"""
        print("\n🔍 Search Nodes")
        print("-" * 40)
        query = self.get_input("Search query: ")
        
        if query:
            results = self.kg.search_nodes(query)
            if results:
                print(f"\nFound {len(results)} nodes:")
                for node in results:
                    print(f"   {node.id}. {node.status.value} {node.category.value} {node.title}")
                    print(f"      {node.description[:50]}...")
            else:
                print("❌ No nodes found!")
    
    def run(self):
        """Main application loop"""
        while True:
            self.print_header()
            self.display_menu()
            
            choice = self.get_input("Enter your choice: ")
            
            if choice == '1':
                self.create_node_menu()
            elif choice == '2':
                self.link_nodes_menu()
            elif choice == '3':
                self.add_dependency_menu()
            elif choice == '4':
                self.update_status_menu()
            elif choice == '5':
                self.update_priority_menu()
            elif choice == '6':
                self.add_tag_menu()
            elif choice == '7':
                self.add_reflection_menu()
            elif choice == '8':
                self.kg.display_full_tree()
            elif choice == '9':
                node_id = self.get_int_input("Enter Node ID: ")
                self.kg.display_node_details(node_id)
            elif choice == '10':
                self.search_menu()
            elif choice == '11':
                self.kg.display_statistics()
            elif choice == '12':
                self.kg.display_visual_timeline()
            elif choice == '13':
                self.kg.display_smart_recommendations()
            elif choice == '14':
                self.kg.display_daily_inspiration()
            elif choice == '15':
                self.kg.save_data()
            elif choice == '16':
                self.kg.load_data()
            elif choice == '17':
                print("\n👋 Thank you for using MindMap!")
                self.kg.save_data()
                break
            else:
                print("❌ Invalid choice! Please enter a number between 1-17.")
            
            input("\nPress Enter to continue...")

