                print("❌ Please enter a valid number!")
    
    def get_choice_from_enum(self, enum_class, prompt: str):
        """Get user choice from enum"""
        items = list(enum_class)
        for i, item in enumerate(items, 1):
            print(f"   {i}. {item.value} {item.name}")
        
        while True:
            try:
                choice = self.get_int_input(prompt)
                if 1 <= choice <= len(items):
                    return items[choice - 1]
                print(f"❌ Please enter a number between 1 and {len(items)}!")
            except ValueError:
                print("❌ Invalid input!")
    
    def create_node_menu(self):
        """Menu for creating a new node"""
        print("\n📝 Create New Knowledge Node")
        print("-" * 40)
        
        title = self.get_input("Title: ")
        if not title:
            print("❌ Title cannot be empty!")
            return
        
        description = self.get_input("Description: ")
        
        print("\nSelect Category:")
        category = self.get_choice_from_enum(Category, "Choice: ")
        
        print("\nSelect Priority:")
        priority = self.get_choice_from_enum(Priority, "Choice: ")
        
        node_id = self.kg.create_node(title, description, category)
        self.kg.update_priority(node_id, priority)
        
        # Ask if want to set deadline
        if self.get_input("Set deadline? (y/n): ").lower() == 'y':
            date_str = self.get_input("Deadline (YYYY-MM-DD): ")
            try:
                deadline = datetime.strptime(date_str, "%Y-%m-%d")
                self.kg.update_deadline(node_id, deadline)
            except ValueError:
                print("❌ Invalid date format!")
    
    def link_nodes_menu(self):
        """Menu for linking nodes"""
        print("\n🔗 Link Nodes")
        print("-" * 40)
        print("Available nodes:")
        for node in self.kg.nodes.values():
            print(f"   {node.id}. {node.category.value} {node.title}")
        
        parent_id = self.get_int_input("Parent Node ID: ")
        child_id = self.get_int_input("Child Node ID: ")
        self.kg.add_child(parent_id, child_id)
    
