class KnowledgeGraph:
    def __init__(self, name: str = "My MindMap"):
        self.name = name
        self.nodes: Dict[int, KnowledgeNode] = {}
        self.next_id = 1
        self.created = datetime.now()
        self.quote_manager = QuoteManager()
        self.data_file = "mindmap.json"
        self.load_data()
    
    # ========== NODE OPERATIONS ==========
    
    def create_node(self, title: str, description: str, category: Category) -> int:
        """Create a new knowledge node"""
        node = KnowledgeNode(self.next_id, title, description, category)
        self.nodes[node.id] = node
        self.next_id += 1
        print(f"✅ Created node: {category.value} {title}")
        return node.id
    
    def add_child(self, parent_id: int, child_id: int) -> bool:
        """Add child relationship between nodes"""
        parent = self.nodes.get(parent_id)
        child = self.nodes.get(child_id)
        if parent and child:
            parent.child_ids.append(child_id)
            child.parent_id = parent_id
            print(f"🔗 Linked {parent.title} -> {child.title}")
            return True
        print("❌ Parent or child not found!")
        return False
    
    def add_dependency(self, node_id: int, dep_id: int) -> bool:
        """Add dependency relationship"""
        node = self.nodes.get(node_id)
        dep = self.nodes.get(dep_id)
        if node and dep:
            node.dependency_ids.append(dep_id)
            print(f"📌 Added dependency: {node.title} depends on {dep.title}")
            return True
        print("❌ Node or dependency not found!")
        return False
    
    # ========== UPDATE OPERATIONS ==========
    
    def update_status(self, node_id: int, status: Status) -> bool:
        """Update node status"""
        node = self.nodes.get(node_id)
        if node:
            node.status = status
            print(f"📊 Updated {node.title}: {status.value}")
            return True
        print("❌ Node not found!")
        return False
    
    def update_priority(self, node_id: int, priority: Priority) -> bool:
        """Update node priority"""
        node = self.nodes.get(node_id)
        if node:
            node.priority = priority
            print(f"🎯 Updated priority for {node.title}: {priority}")
            return True
        print("❌ Node not found!")
        return False
    
    def update_deadline(self, node_id: int, deadline: datetime) -> bool:
        """Update node deadline"""
        node = self.nodes.get(node_id)
        if node:
            node.deadline = deadline
            print(f"📅 Updated deadline for {node.title}")
            return True
        print("❌ Node not found!")
        return False
    
    def add_tag(self, node_id: int, tag: str) -> bool:
        """Add tag to node"""
        node = self.nodes.get(node_id)
        if node and tag not in node.tags:
            node.tags.append(tag)
            print(f"🏷️ Added tag '{tag}' to {node.title}")
            return True
        print("❌ Node not found or tag already exists!")
        return False
    
    def add_reflection(self, node_id: int, reflection: str) -> bool:
        """Add reflection/notes to node"""
        node = self.nodes.get(node_id)
        if node:
            node.reflection = reflection
            print(f"📝 Added reflection to {node.title}")
            return True
        print("❌ Node not found!")
        return False
    
    # ========== VIEW OPERATIONS ==========
    
    def display_tree(self, root_id: int, level: int = 0, prefix: str = ""):
        """Display tree structure recursively"""
        node = self.nodes.get(root_id)
        if not node:
            return
        
        indent = "│   " * level
        if level > 0:
            indent = prefix + "├── "
        
        progress = ""
        if node.status == Status.COMPLETED:
            progress = " ✅ 100%"
        elif node.status == Status.IN_PROGRESS:
            progress = " 🔄 50%"
        
        print(f"{indent}{node.status.value} {node.category.value} {node.title}{progress}")
        
        for i, child_id in enumerate(node.child_ids):
            is_last = i == len(node.child_ids) - 1
            new_prefix = "    " * (level + 1) + ("    " if is_last else "│   ")
            self.display_tree(child_id, level + 1, new_prefix)
    
    def display_full_tree(self):
        """Display complete knowledge tree"""
        roots = [n for n in self.nodes.values() if n.parent_id == -1]
        roots.sort(key=lambda x: x.title)
        
        if not roots:
            print("📭 No nodes found. Create some knowledge first!")
            return
        
        print("\n🌳 " + "=" * 60)
        print(f"     {self.name.upper()} KNOWLEDGE TREE")
        print("🌳 " + "=" * 60)
        print("\nLegend: ⏳Not Started | 🔄In Progress | ✅Completed | 🚫Blocked | 👀Review\n")
        
        for root in roots:
            print(f"📌 {root.category.value} {root.title}")
            for child_id in root.child_ids:
                self.display_tree(child_id, 1)
            print()
        
        print(f"📊 Total: {len(self.nodes)} nodes\n")
    
    def display_node_details(self, node_id: int):
        """Display detailed information about a node"""
        node = self.nodes.get(node_id)
        if not node:
            print("❌ Node not found!")
            return
        
        print("\n📋 " + "=" * 70)
        print(f"📌 {node.category.value} {node.title}")
        print("📖 " + "=" * 70)
        print(f"Description: {node.description}")
        print(f"Status: {node.status.value} {node.status.name}")
        print(f"Priority: {node.priority}")
        print(f"Created: {node.created.strftime('%Y-%m-%d %H:%M')}")
        print(f"Deadline: {node.deadline.strftime('%Y-%m-%d %H:%M')}")
        print(f"Energy Required: {'⚡' * node.energy_required}")
        print(f"Estimated Hours: {node.estimated_hours}")
        print(f"Actual Hours: {node.actual_hours}")
        print(f"Priority Score: {node.get_priority_score()}/100")
        print(f"Progress: {node.get_progress():.1f}%")
        
        if node.tags:
            print(f"Tags: {', '.join(node.tags)}")
        if node.resources:
            print(f"Resources: {', '.join(node.resources)}")
        if node.reflection:
            print(f"Reflection:\n{textwrap.fill(node.reflection, 70)}")
        
        if node.child_ids:
            children = [self.nodes[cid].title for cid in node.child_ids if cid in self.nodes]
            print(f"Children: {', '.join(children)}")
        if node.dependency_ids:
            deps = [self.nodes[did].title for did in node.dependency_ids if did in self.nodes]
            print(f"Dependencies: {', '.join(deps)}")
        
        print("📖 " + "=" * 70 + "\n")
    
    # ========== SEARCH OPERATIONS ==========
    
    def search_nodes(self, query: str) -> List[KnowledgeNode]:
        """Search nodes by title, description, or tags"""
        query = query.lower()
        results = []
        for node in self.nodes.values():
            if (query in node.title.lower() or 
                query in node.description.lower() or
                any(query in tag.lower() for tag in node.tags)):
                results.append(node)
        return results
    
    def get_nodes_by_category(self, category: Category) -> List[KnowledgeNode]:
        """Get all nodes in a category"""
        return [n for n in self.nodes.values() if n.category == category]
    
    def get_nodes_by_status(self, status: Status) -> List[KnowledgeNode]:
        """Get all nodes with specific status"""
        return [n for n in self.nodes.values() if n.status == status]
    
    # ========== ANALYTICS ==========
    
    def display_statistics(self):
        """Display comprehensive analytics"""
        if not self.nodes:
            print("📭 No data to analyze. Start adding knowledge nodes!")
            return
        
        total = len(self.nodes)
        completed = sum(1 for n in self.nodes.values() if n.status == Status.COMPLETED)
        in_progress = sum(1 for n in self.nodes.values() if n.status == Status.IN_PROGRESS)
        not_started = sum(1 for n in self.nodes.values() if n.status == Status.NOT_STARTED)
        blocked = sum(1 for n in self.nodes.values() if n.status == Status.BLOCKED)
        
        print("\n📊 " + "=" * 70)
        print(f"         {self.name.upper()} ANALYTICS")
        print("📊 " + "=" * 70)
        
        print(f"\n📈 Overview:")
        print(f"   Total Nodes: {total}")
        print(f"   ✅ Completed: {completed} ({completed/total*100:.1f}%)")
        print(f"   🔄 In Progress: {in_progress} ({in_progress/total*100:.1f}%)")
        print(f"   ⏳ Not Started: {not_started} ({not_started/total*100:.1f}%)")
        print(f"   🚫 Blocked: {blocked} ({blocked/total*100:.1f}%)")
        
        # Progress bar
        progress = (completed / total) * 100
        bar_length = 40
        filled = int(bar_length * progress / 100)
        bar = '█' * filled + '░' * (bar_length - filled)
        print(f"\n   📊 Overall Progress: [{bar}] {progress:.1f}%")
        
        # Category breakdown
        print("\n📂 By Category:")
        for category in Category:
            count = sum(1 for n in self.nodes.values() if n.category == category)
            if count > 0:
                print(f"   {category.value} {category.name}: {count}")
        
        # Priority breakdown
        print("\n🎯 By Priority:")
        for priority in Priority:
            count = sum(1 for n in self.nodes.values() if n.priority == priority)
            if count > 0:
                print(f"   {priority.get_icon()} {priority.name}: {count}")
        
        # Most active day
        print("\n📅 Activity:")
        days = defaultdict(int)
        for node in self.nodes.values():
            day = node.created.strftime("%Y-%m-%d")
            days[day] += 1
        
        if days:
            most_active = max(days.items(), key=lambda x: x[1])
            print(f"   Most active day: {most_active[0]} ({most_active[1]} nodes)")
        
        # Top tags
        all_tags = [tag for node in self.nodes.values() for tag in node.tags]
        if all_tags:
            tag_counts = defaultdict(int)
            for tag in all_tags:
                tag_counts[tag] += 1
            top_tags = sorted(tag_counts.items(), key=lambda x: x[1], reverse=True)[:5]
            print("\n🏷️ Top Tags:")
            for tag, count in top_tags:
                print(f"   #{tag}: {count}")
        
        print("\n" + "=" * 70 + "\n")
    
    def display_visual_timeline(self):
        """Display a visual timeline of nodes"""
        if not self.nodes:
            print("📭 No nodes to display!")
            return
        
        print("\n📅 " + "=" * 70)
        print("         KNOWLEDGE TIMELINE")
        print("📅 " + "=" * 70)
        
        sorted_nodes = sorted(self.nodes.values(), key=lambda x: x.created)
        
        for node in sorted_nodes:
            date_str = node.created.strftime("%Y-%m-%d")
            status_icon = node.status.value
            progress = node.get_progress()
            
            # Progress bar
            bar_length = 20
            filled = int(bar_length * progress / 100)
            bar = '█' * filled + '░' * (bar_length - filled)
            
            print(f"{date_str} {status_icon} {node.category.value} {node.title[:30]}")
            print(f"         [{bar}] {progress:.0f}%")
            print()
    
    # ========== SAVE/LOAD OPERATIONS ==========
    
    def save_data(self):
        """Save all data to JSON file"""
        try:
            data = {
                'name': self.name,
                'next_id': self.next_id,
                'created': self.created.isoformat(),
                'nodes': {str(k): v.to_dict() for k, v in self.nodes.items()}
            }
            
            with open(self.data_file, 'w') as f:
                json.dump(data, f, indent=2)
            
            print("💾 Data saved successfully!")
        except Exception as e:
            print(f"❌ Error saving data: {e}")
    
    def load_data(self):
        """Load data from JSON file"""
        if not os.path.exists(self.data_file):
            print("📝 No saved data found. Starting fresh!")
            return
        
        try:
            with open(self.data_file, 'r') as f:
                data = json.load(f)
            
            self.name = data.get('name', self.name)
            self.next_id = data.get('next_id', 1)
            self.created = datetime.fromisoformat(data['created'])
            
            self.nodes = {}
            for node_id, node_data in data['nodes'].items():
                node = KnowledgeNode.from_dict(node_data)
                self.nodes[node.id] = node
            
            print(f"📂 Loaded {len(self.nodes)} nodes from file!")
        except Exception as e:
            print(f"❌ Error loading data: {e}")
    
    # ========== AI-LIKE FEATURES ==========
    
    def get_smart_recommendations(self) -> List[KnowledgeNode]:
        """Get smart recommendations based on priority and deadlines"""
        if not self.nodes:
            return []
        
        # Score each node
        scored_nodes = []
        for node in self.nodes.values():
            if node.status in [Status.NOT_STARTED, Status.IN_PROGRESS]:
                score = node.get_priority_score()
                # Bonus for upcoming deadlines
                days_until = (node.deadline - datetime.now()).days
                if days_until <= 0:
                    score += 20
                elif days_until <= 3:
                    score += 10
                
                scored_nodes.append((score, node))
        
        scored_nodes.sort(reverse=True)
        return [node for _, node in scored_nodes[:5]]
    
    def display_smart_recommendations(self):
        """Display AI-like recommendations"""
        recommendations = self.get_smart_recommendations()
        
        if not recommendations:
            print("🎯 No immediate recommendations. Great job!")
            return
        
        print("\n🎯 " + "=" * 70)
        print("     SMART RECOMMENDATIONS (AI-Powered)")
        print("🎯 " + "=" * 70)
        print("\nBased on urgency, importance, and dependencies:")
        
        for i, node in enumerate(recommendations, 1):
            score = node.get_priority_score()
            urgency = node.get_urgency_score()
            
            urgency_icons = ["😌", "🤔", "😅", "😰", "🚨"]
            urgency_level = min(4, max(0, urgency // 2))
            urgency_icon = urgency_icons[urgency_level]
            
            print(f"\n{i}. {urgency_icon} {node.category.value} {node.title}")
            print(f"   Score: {score}/100 | Urgency: {urgency}/10")
            print(f"   Deadline: {node.deadline.strftime('%Y-%m-%d')}")
            if node.dependency_ids:
                deps = [self.nodes[did].title for did in node.dependency_ids if did in self.nodes]
                if deps:
                    print(f"   Dependencies: {', '.join(deps)}")
            print(f"   💡 {random.choice(['Focus on this now!', 'High priority!', 'Time-sensitive!', 'Critical path!'])}")
        
        print("\n" + "=" * 70 + "\n")
    
    def display_daily_inspiration(self):
        """Display daily inspiration"""
        quote = self.quote_manager.get_daily_quote()
        print("\n✨ " + "=" * 70)
        print("     DAILY INSPIRATION")
        print("✨ " + "=" * 70)
        print(f"\n{quote}\n")
        print("=" * 70 + "\n")

